{
  "application": {
    "name": "OfflineSuite",
    "description": "Free offline tools for PDF editing, image processing, and document management. 100% private - all processing happens locally in your browser.",
    "url": "https://offlinesuite.com",
    "version": "1.0.0",
    "author": "OfflineSuite Team"
  },
  "features": {
    "privacy": {
      "data_upload": false,
      "data_storage": false,
      "user_tracking": false,
      "requires_account": false,
      "offline_capable": true
    },
    "capabilities": {
      "pdf_editing": true,
      "image_processing": true,
      "document_generation": true,
      "format_conversion": true,
      "offline_mode": true
    }
  },
  "tools": [
    {
      "id": "pdf-merger",
      "name": "PDF Merger",
      "category": "pdf",
      "description": "Combine multiple PDF files into one",
      "keywords": ["pdf", "merge", "combine", "join"],
      "url": "/tool/pdf-merger"
    },
    {
      "id": "pdf-compress",
      "name": "PDF Compressor",
      "category": "pdf",
      "description": "Reduce PDF file sizes",
      "keywords": ["pdf", "compress", "optimize", "reduce"],
      "url": "/tool/pdf-compress"
    },
    {
      "id": "pdf-editor",
      "name": "PDF Editor",
      "category": "pdf",
      "description": "Edit PDF documents",
      "keywords": ["pdf", "edit", "modify", "split", "rotate"],
      "url": "/tool/pdf-editor"
    },
    {
      "id": "pdf-watermark",
      "name": "PDF Watermark",
      "category": "pdf",
      "description": "Add watermarks to PDFs",
      "keywords": ["pdf", "watermark", "stamp", "brand"],
      "url": "/tool/pdf-watermark"
    },
    {
      "id": "pdf-sign",
      "name": "PDF Signer",
      "category": "pdf",
      "description": "Add digital signatures to PDFs",
      "keywords": ["pdf", "sign", "signature", "digital"],
