    },
    {
      "id": "pdf-to-images",
      "name": "PDF to Images",
      "category": "converter",
      "description": "Convert PDF pages to images",
      "keywords": ["pdf", "image", "convert", "png", "jpg"],
      "url": "/tool/pdf-to-images"
    },
    {
      "id": "pdf-metadata",
      "name": "PDF Metadata Editor",
      "category": "pdf",
      "description": "Edit PDF properties and metadata",
      "keywords": ["pdf", "metadata", "properties", "info"],
      "url": "/tool/pdf-metadata"
    },
    {
      "id": "pdf-diff",
      "name": "PDF Diff Tool",
