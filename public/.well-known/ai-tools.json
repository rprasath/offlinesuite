    {
      "id": "signature-maker",
      "name": "Signature Maker",
      "category": "image",
      "description": "Extract signatures from photos",
      "keywords": ["signature", "extract", "transparent", "sign"],
      "url": "/tool/signature-maker"
    },
    {
      "id": "text-diff",
      "name": "Text Diff Tool",
      "category": "utility",
      "description": "Compare text files",
      "keywords": ["text", "diff", "compare", "difference"],
